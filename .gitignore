# Python
__pycache__/
*.pyc

# ROS2 build output
build/
install/
log/

# Large local datasets, training runs and archives (not tracked)
runs/
yolo_dataset*/
cvat_exports*/
zone_crops*/
*.zip
*.tar.gz
*.tgz
*.npy

# Model and image files are ignored by default...
*.pt
*.onnx
*.jpg
*.png
# ...except the ones the README uses
!weights/**/*.pt
!weights/**/*.onnx
!docs/**/*.jpg
!docs/**/*.png
!training/v1/results/*.png
!training/v1/results/*.jpg
